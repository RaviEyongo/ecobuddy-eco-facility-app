    <!-- Live seracch script  -->
    <script>
        document.getElementById('liveSearchInput').addEventListener('input', function() {
            const query = this.value.trim();
            //Hide results box if input is empty
            if (query === '') {
                document.getElementById('searchResults').innerHTML = '';
                document.getElementById('searchResults').style.display = 'none';
                return;
            }

            //If input is valid, fetch and show live results
            if (LiveSearch.validateInput(query)) {
                LiveSearch.fetchResults(query, function(error, data) {
                    if (error) {
                        console.error("Fetching error:", error);
                        document.getElementById('searchResults').innerHTML = '<div class="list-group-item text-danger">Error loading results</div>';
                        document.getElementById('searchResults').style.display = 'block';
                        return;
                    }
                    LiveSearch.renderResults(data);
                    document.getElementById('searchResults').style.display = 'block';
                });
            } else {
                //Show validation error message
                document.getElementById('searchResults').innerHTML = '<div class="list-group-item text-warning">Invalid input detected.</div>';
                document.getElementById('searchResults').style.display = 'block';
            }
        });
    </script>

